---
import '../styles/global.css';
import fontHref from '@fontsource-variable/archivo/files/archivo-latin-standard-normal.woff2?url';
import Seo from '../components/Seo.astro';
import SchemaOrg from '../components/SchemaOrg.astro';
import Atmosphere from '../components/ui/Atmosphere.astro';

interface Props {
	title?: string;
	description?: string;
	noindex?: boolean;
}

const { title, description, noindex } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<script is:inline>
			document.documentElement.classList.add('js');
		</script>
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="theme-color" content="#0e0c0d" />
		<link rel="preload" as="font" type="font/woff2" href={fontHref} crossorigin="anonymous" />
		<meta name="generator" content={Astro.generator} />
		<Seo title={title} description={description} noindex={noindex} />
		<SchemaOrg />
		<slot name="head" />
	</head>
	<body>
		<slot />
		<Atmosphere />
	</body>
</html>
