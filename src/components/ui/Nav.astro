---
import Logo from '../Logo.astro';
import { NAV_LINKS, SITE } from '../../lib/site';
---

<header class="nav" data-nav data-theme="dark" data-scrolled="false">
	<div class="nav-inner container-page">
		<a href="#top" class="nav-logo" aria-label={`${SITE.name}, back to top`}>
			<Logo variant="lockup" class="h-full w-auto" />
		</a>
		<nav aria-label="Sections" class="nav-links">
			<ul>
				{
					NAV_LINKS.map((link) => (
						<li>
							<a href={link.href} class="nav-link">
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
		<a href="#contact" class="btn nav-cta" data-magnetic>Let's talk</a>
	</div>
</header>

<style>
	.nav {
		--nav-fg: var(--color-bone);
		--nav-bg: var(--color-ink);
		position: fixed;
		inset: 0 0 auto;
		z-index: 50;
		color: var(--nav-fg);
		transition: color var(--dur-slow) var(--ease-cinema);
	}

	/* A soft fade instead of a hard bar, so the scenes keep breathing behind it. */
	.nav::before {
		content: '';
		position: absolute;
		inset: 0 0 -1.5rem;
		background: linear-gradient(
			to bottom,
			color-mix(in oklab, var(--nav-bg) 88%, transparent),
			transparent
		);
		opacity: 0;
		pointer-events: none;
		transition:
			opacity var(--dur-slow) var(--ease-cinema),
			background var(--dur-slow) var(--ease-cinema);
	}

	.nav[data-scrolled='true']::before {
		opacity: 1;
	}

	.nav[data-theme='light'] {
		--nav-fg: var(--color-rouge);
		--nav-bg: var(--color-bone);
	}

	.nav-inner {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
		height: var(--nav-h);
	}

	.nav-logo {
		display: flex;
		align-items: center;
		height: 1rem;
		min-height: var(--tap);
		padding-block: calc((var(--tap) - 1rem) / 2);
	}

	.nav-links {
		display: none;
	}

	.nav-links ul {
		display: flex;
		gap: 2.25rem;
	}

	.nav-link {
		position: relative;
		display: inline-flex;
		align-items: center;
		min-height: var(--tap);
		font-size: var(--text-sm);
		letter-spacing: 0.02em;
		opacity: 0.78;
		transition: opacity var(--dur-base) var(--ease-cinema);
	}

	.nav-link::after {
		content: '';
		position: absolute;
		inset: auto 0 0.6rem;
		height: 1px;
		background-color: currentColor;
		transform: scaleX(0);
		transform-origin: right center;
		transition: transform var(--dur-slow) var(--ease-cinema);
	}

	.nav-link:hover {
		opacity: 1;
	}

	.nav-link:hover::after {
		transform: scaleX(1);
		transform-origin: left center;
	}

	.nav-cta {
		display: none;
		min-height: var(--tap);
		padding-inline: 1.35rem;
		border: 1px solid color-mix(in oklab, var(--nav-fg) 35%, transparent);
		color: var(--nav-fg);
	}

	.nav-cta:hover {
		border-color: var(--nav-fg);
	}

	@media (min-width: 1024px) {
		.nav-links,
		.nav-cta {
			display: flex;
		}
	}
</style>
