---
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/Logo.astro';
import { SITE } from '../lib/site';
---

<BaseLayout
	title={`Page not found · ${SITE.name}`}
	description="This page doesn't exist anymore. Everything now lives on one page."
	noindex
>
	<main class="lost">
		<a href="/" class="lost-logo" aria-label={`${SITE.name}, home`}>
			<Logo variant="signet" class="h-full w-auto" />
		</a>
		<p class="label">404</p>
		<h1 class="lost-title">This reel is missing.</h1>
		<p class="lost-body">
			The page you were looking for doesn't exist anymore. I moved everything onto one page, so it's
			all just a scroll away.
		</p>
		<div class="lost-actions">
			<a href="/" class="btn btn-primary"
				>Take me home <span class="btn-arrow" aria-hidden="true">→</span></a
			>
			<a href="/#work" class="btn btn-ghost">See my work</a>
		</div>
	</main>
</BaseLayout>

<style>
	.lost {
		display: grid;
		justify-items: center;
		align-content: center;
		gap: 1.25rem;
		min-height: 100svh;
		padding: var(--section-y) var(--gutter);
		text-align: center;
		background: radial-gradient(
			ellipse 60% 50% at 50% 40%,
			color-mix(in oklab, var(--color-rouge) 40%, transparent),
			transparent 70%
		);
	}

	.lost-logo {
		height: 4rem;
		margin-bottom: 1.5rem;
		color: var(--color-bone);
	}

	.lost-title {
		max-width: 14ch;
		font-size: var(--text-5xl);
		line-height: var(--text-5xl--line-height);
	}

	.lost-body {
		max-width: 30rem;
		color: var(--color-bone-muted);
	}

	.lost-actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.75rem;
		margin-top: 1rem;
	}
</style>
