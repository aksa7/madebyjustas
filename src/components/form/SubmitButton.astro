---
interface Props {
	label: string;
}

const { label } = Astro.props;
---

<button type="submit" class="btn btn-primary submit" data-submit-button data-magnetic disabled>
	<span data-submit-spinner aria-hidden="true" class="submit-spinner hidden"></span>
	<span data-submit-label>{label}</span>
	<span class="btn-arrow" aria-hidden="true">→</span>
</button>

<style>
	.submit:disabled {
		cursor: not-allowed;
		opacity: 0.45;
	}

	.submit-spinner {
		width: 1rem;
		height: 1rem;
		border: 2px solid color-mix(in oklab, currentColor 35%, transparent);
		border-top-color: currentColor;
		border-radius: var(--radius-full);
		animation: spin 0.8s linear infinite;
	}

	@keyframes spin {
		to {
			transform: rotate(360deg);
		}
	}
</style>
