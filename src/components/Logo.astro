---
import lockup from '../assets/brand/lockup.svg?raw';
import signet from '../assets/brand/signet.svg?raw';
import signetSmall from '../assets/brand/signet-small.svg?raw';

interface Props {
	variant?: 'lockup' | 'signet' | 'signet-small';
	class?: string;
	/** Accessible name. Omit when the logo sits inside a link that already has one. */
	label?: string;
}

const { variant = 'lockup', class: className = '', label } = Astro.props;
const sources = { lockup, signet, 'signet-small': signetSmall } as const;

// The SVGs use clipPaths (the M flowing into the J), so every instance needs
// its own ids or two logos on one page would clip each other.
const uid = Math.random().toString(36).slice(2, 8);
const a11y = label ? `role="img" aria-label="${label}"` : 'aria-hidden="true"';
const svg = sources[variant]
	.replace(/id="([\w-]+)"/g, `id="$1-${uid}"`)
	.replace(/url\(#([\w-]+)\)/g, `url(#$1-${uid})`)
	.replace('<svg ', `<svg class="${className}" ${a11y} focusable="false" `);
---

<Fragment set:html={svg} />
