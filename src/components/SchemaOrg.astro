---
import { SITE } from '../lib/site';
import { SERVICES } from '../lib/content';

const personId = `${SITE.url}/#person`;
const businessId = `${SITE.url}/#business`;
const websiteId = `${SITE.url}/#website`;

const schema = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'WebSite',
			'@id': websiteId,
			name: SITE.name,
			url: SITE.url,
			description: SITE.description,
			inLanguage: 'en',
			publisher: { '@id': businessId },
		},
		{
			'@type': 'Person',
			'@id': personId,
			name: SITE.author,
			url: SITE.url,
			email: `mailto:${SITE.email}`,
			jobTitle: SITE.jobTitle,
			description:
				'Independent web developer with a software engineering background. Designs and hand-codes fast websites for service businesses.',
			knowsAbout: [
				'Web design',
				'Web development',
				'Search engine optimization',
				'Generative engine optimization',
				'Web performance',
			],
			sameAs: [SITE.linkedin],
		},
		{
			'@type': 'ProfessionalService',
			'@id': businessId,
			name: SITE.name,
			url: SITE.url,
			email: SITE.email,
			image: new URL(SITE.ogImage, SITE.url).toString(),
			description: SITE.description,
			founder: { '@id': personId },
			areaServed: 'Worldwide',
			knowsLanguage: ['en', 'lt'],
			hasOfferCatalog: {
				'@type': 'OfferCatalog',
				name: 'Website services',
				itemListElement: SERVICES.map((service) => ({
					'@type': 'Offer',
					itemOffered: { '@type': 'Service', name: service.name, description: service.lead },
				})),
			},
			sameAs: [SITE.linkedin],
		},
	],
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
