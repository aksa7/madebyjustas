---
import { getImage } from 'astro:assets';
import beamImage from '../../assets/media/beam-16x9.webp';
import { MANIFESTO } from '../../lib/content';

const beam = await getImage({
	src: beamImage,
	widths: [960, 1600, 2400],
	format: 'webp',
	quality: 70,
});
---

<section class="manifesto" data-manifesto aria-labelledby="manifesto-title">
	<div class="manifesto-stage">
		<img
			class="manifesto-beam"
			data-manifesto-beam
			src={beam.src}
			srcset={beam.srcSet.attribute}
			sizes="100vw"
			width={beam.attributes.width}
			height={beam.attributes.height}
			alt=""
			loading="lazy"
			decoding="async"
		/>
		<canvas class="manifesto-dust" data-dust aria-hidden="true"></canvas>
		<div class="container-page manifesto-copy">
			<h2 id="manifesto-title" class="label">Why I build this way</h2>
			<p class="manifesto-text" data-manifesto-text>{MANIFESTO}</p>
		</div>
	</div>
</section>

<style>
	.manifesto {
		position: relative;
		height: 200svh;
	}

	.manifesto-stage {
		position: sticky;
		top: 0;
		height: 100svh;
		display: grid;
		align-items: center;
		overflow: hidden;
	}

	.manifesto-beam {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: left top;
		mix-blend-mode: screen;
		opacity: 0.35;
		pointer-events: none;
	}

	.manifesto-dust {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		mix-blend-mode: screen;
	}

	.manifesto-copy {
		position: relative;
	}

	.manifesto-text {
		margin-top: 2rem;
		max-width: 24em;
		font-family: var(--font-display);
		font-weight: 560;
		font-variation-settings: 'wdth' 104;
		letter-spacing: var(--tracking-display);
		font-size: var(--text-statement);
		line-height: var(--text-statement--line-height);
		text-wrap: pretty;
	}

	@media (min-width: 1024px) {
		.manifesto {
			height: 240svh;
		}

		.manifesto-copy {
			padding-left: calc(var(--gutter) + 12vw);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.manifesto {
			height: auto;
		}

		.manifesto-stage {
			position: relative;
			height: auto;
			padding-block: var(--section-y);
		}
	}
</style>
